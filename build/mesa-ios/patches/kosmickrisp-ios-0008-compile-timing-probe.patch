+#include "util/os_time.h"
+#include "util/u_atomic.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Madeira probe (Detroit shader compile): where does pipeline-creation time
+ * go, and how many pipelines are built at once? Logs one "[kk-compile]" line
+ * at most every 10 s while pipelines are being made. Logging only; it does
+ * not change what is compiled. Off: MADEIRA_KK_COMPILE_TIMING=0.
+ * Not counted: SPIR-V -> NIR in the Vulkan runtime before kk_compile_shaders. */
+enum { KK_CT_NEW = 0, KK_CT_HIT = 1, KK_CT_KINDS = 2 };
+static struct {
+   uint64_t n[KK_CT_KINDS];
+   uint64_t total_ns[KK_CT_KINDS];
+   uint64_t metal_ns[KK_CT_KINDS];
+   uint64_t max_ns[KK_CT_KINDS];
+   int32_t in_flight;
+   int32_t max_in_flight;
+   int64_t last_print_ns;
+   uint64_t prev_n[KK_CT_KINDS];
+} kk_ct;
+static __thread int kk_ct_tls_kind = -1;
+
+static bool
+kk_ct_on(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("MADEIRA_KK_COMPILE_TIMING");
+      on = !(e && !strcmp(e, "0"));
+   }
+   return on;
+}
+
+static void
+kk_ct_max_u64(uint64_t *dst, uint64_t v)
+{
+   uint64_t cur = p_atomic_read(dst);
+   while (v > cur) {
+      uint64_t seen = p_atomic_cmpxchg(dst, cur, v);
+      if (seen == cur)
+         break;
+      cur = seen;
+   }
+}
+
+static int64_t
+kk_ct_begin(int kind)
+{
+   if (!kk_ct_on() || kk_ct_tls_kind >= 0)
+      return 0;
+   kk_ct_tls_kind = kind;
+   int32_t now = p_atomic_inc_return(&kk_ct.in_flight);
+   int32_t cur = p_atomic_read(&kk_ct.max_in_flight);
+   while (now > cur) {
+      int32_t seen = p_atomic_cmpxchg(&kk_ct.max_in_flight, cur, now);
+      if (seen == cur)
+         break;
+      cur = seen;
+   }
+   return os_time_get_nano();
+}
+
+static void
+kk_ct_print(int64_t now)
+{
+   int64_t last = p_atomic_read(&kk_ct.last_print_ns);
+   if (now - last < 10000000000ll)
+      return;
+   if (p_atomic_cmpxchg(&kk_ct.last_print_ns, last, now) != last)
+      return; /* another thread prints this window */
+
+   uint64_t n[KK_CT_KINDS], win[KK_CT_KINDS];
+   double avg_ms[KK_CT_KINDS], metal_pct[KK_CT_KINDS], max_ms[KK_CT_KINDS];
+   for (int k = 0; k < KK_CT_KINDS; k++) {
+      n[k] = p_atomic_read(&kk_ct.n[k]);
+      win[k] = n[k] - kk_ct.prev_n[k];
+      kk_ct.prev_n[k] = n[k];
+      uint64_t tot = p_atomic_read(&kk_ct.total_ns[k]);
+      uint64_t met = p_atomic_read(&kk_ct.metal_ns[k]);
+      avg_ms[k] = n[k] ? (double)tot / n[k] / 1e6 : 0.0;
+      metal_pct[k] = tot ? 100.0 * (double)met / (double)tot : 0.0;
+      max_ms[k] = (double)p_atomic_read(&kk_ct.max_ns[k]) / 1e6;
+   }
+   fprintf(stderr,
+           "[kk-compile] since %s: new %llu, cache-hit %llu | all: new %llu "
+           "avg %.1f ms (Metal %.0f%%) max %.0f ms; cache-hit %llu avg %.1f ms "
+           "(Metal %.0f%%) | at once: now %d, max %d (off: "
+           "MADEIRA_KK_COMPILE_TIMING=0)\n",
+           last ? "last line" : "start", (unsigned long long)win[KK_CT_NEW],
+           (unsigned long long)win[KK_CT_HIT],
+           (unsigned long long)n[KK_CT_NEW], avg_ms[KK_CT_NEW],
+           metal_pct[KK_CT_NEW], max_ms[KK_CT_NEW],
+           (unsigned long long)n[KK_CT_HIT], avg_ms[KK_CT_HIT],
+           metal_pct[KK_CT_HIT], (int)p_atomic_read(&kk_ct.in_flight),
+           (int)p_atomic_read(&kk_ct.max_in_flight));
+}
+
+static void
+kk_ct_end(int kind, int64_t t0)
+{
+   if (t0 == 0)
+      return;
+   int64_t now = os_time_get_nano();
+   uint64_t dt = (uint64_t)(now - t0);
+   p_atomic_add(&kk_ct.total_ns[kind], dt);
+   p_atomic_inc(&kk_ct.n[kind]);
+   kk_ct_max_u64(&kk_ct.max_ns[kind], dt);
+   p_atomic_dec(&kk_ct.in_flight);
+   kk_ct_tls_kind = -1;
+   kk_ct_print(now);
+}
+
+/* Metal library + pipeline-state time, charged to the outer new/hit call. */
+static int64_t
+kk_ct_metal_begin(void)
+{
+   return (kk_ct_tls_kind >= 0) ? os_time_get_nano() : 0;
+}
+
+static void
+kk_ct_metal_end(int64_t t0)
+{
+   if (t0 && kk_ct_tls_kind >= 0)
+      p_atomic_add(&kk_ct.metal_ns[kk_ct_tls_kind],
+                   (uint64_t)(os_time_get_nano() - t0));
+}
