+/* MADEIRA_VKD3D_CAPS_SET = "feature:offset=value,...": after vkd3d-proton
+ * answers, write the 32-bit value at that byte offset of the answer (offset and
+ * value in C notation, e.g. "0:28=0,8:12=0x1000,19:0=1"). Entries past the
+ * structure the game passed are skipped. MADEIRA_VKD3D_CAPS_REFUSE = feature
+ * numbers answered E_INVALIDARG without asking vkd3d-proton, as Madeira's D3D12
+ * does for the features it does not implement. */
+static void madeira_caps_set(D3D12_FEATURE feature, void *feature_data, UINT feature_data_size)
+{
+    char list[512], *p, *end;
+    unsigned long f, off, value;
+
+    if (!vkd3d_get_env_var("MADEIRA_VKD3D_CAPS_SET", list, sizeof(list)))
+        return;
+    for (p = list; *p; )
+    {
+        f = strtoul(p, &end, 0);
+        if (end == p || *end != ':')
+            goto next;
+        p = end + 1;
+        off = strtoul(p, &end, 0);
+        if (end == p || *end != '=')
+            goto next;
+        p = end + 1;
+        value = strtoul(p, &end, 0);
+        if (end == p)
+            goto next;
+        p = end;
+        if (f == (unsigned long)feature && off + 4 <= feature_data_size && !(off & 3))
+        {
+            uint32_t old;
+            memcpy(&old, (uint8_t *)feature_data + off, 4);
+            memcpy((uint8_t *)feature_data + off, &(uint32_t){ (uint32_t)value }, 4);
+            INFO("MADEIRA_VKD3D_CAPS_SET: feature %lu offset %lu: %#x -> %#lx.\n", f, off, old, value);
+        }
+        continue;
+next:
+        while (*p && *p != ',')
+            p++;
+        if (*p)
+            p++;
+    }
+}
