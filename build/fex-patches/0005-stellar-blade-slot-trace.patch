--- a/FEXCore/Source/Interface/Core/JIT/JIT.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
@@ -945,6 +945,37 @@
       str(TMP3, TMP4, TMP2, ARMEmitter::ExtendedType::LSL_64, 3);
       add(ARMEmitter::Size::i64Bit, TMP2, TMP2, 1);
       and_(ARMEmitter::Size::i64Bit, TMP2, TMP2, FEXCore::Core::IosBlockRingEntries - 1);
+#ifdef ARCHITECTURE_arm64ec
+      // Sample the candidate setter's arguments before it runs. No guest
+      // memory access or register/flag changes; use the existing thread ring.
+      if ((IosRingEntryRIP & 0xffffffffffffULL) == 0x140f8cda0ULL) {
+        static const bool Trace = [] {
+          const char* E = getenv("MADEIRA_SB_SLOT_TRACE");
+          return E && E[0] == '1' && !E[1];
+        }();
+        if (Trace) {
+          ARMEmitter::ForwardLabel Skip;
+          const auto Address = StaticRegisters[X86State::REG_RCX];
+          const auto Incoming = StaticRegisters[X86State::REG_RDX];
+          lsr(ARMEmitter::Size::i64Bit, TMP3, Address, 46);
+          (void)cbnz(ARMEmitter::Size::i64Bit, TMP3, &Skip);
+          lsr(ARMEmitter::Size::i64Bit, TMP3, Incoming, 46);
+          (void)cbnz(ARMEmitter::Size::i64Bit, TMP3, &Skip);
+          const auto Append = [&](auto Reg, uint64_t Tag) {
+            LoadConstant(ARMEmitter::Size::i64Bit, TMP3, Tag);
+            add(ARMEmitter::Size::i64Bit, TMP3, TMP3, Reg, ARMEmitter::ShiftType::LSL, 0);
+            str(TMP3, TMP4, TMP2, ARMEmitter::ExtendedType::LSL_64, 3);
+            add(ARMEmitter::Size::i64Bit, TMP2, TMP2, 1);
+            and_(ARMEmitter::Size::i64Bit, TMP2, TMP2, FEXCore::Core::IosBlockRingEntries - 1);
+          };
+          // The existing dump prints the low 48 bits. Bit 47 marks data;
+          // bit 46 distinguishes the incoming value from the slot address.
+          Append(Address, 0x0000800000000000ULL);
+          Append(Incoming, 0x0000c00000000000ULL);
+          (void)Bind(&Skip);
+        }
+      }
+#endif
       str(TMP2, TMP1, 0);
       (void)Bind(&l_NoRing);
     }
