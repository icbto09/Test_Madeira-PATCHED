+#ifdef ARCHITECTURE_arm64ec
+      // Log the Stellar Blade slot-selection routine before it uses a slot.
+      // Gated by MADEIRA_SB_SLOT_TRACE; no guest memory access or flag changes.
+      if ((IosRingEntryRIP & 0xffffffffffffULL) == 0x142e3ecd9ULL) {
+        static const bool Trace = [] {
+          const char* E = getenv("MADEIRA_SB_SLOT_TRACE");
+          return E && E[0] == '1' && !E[1];
+        }();
+        if (Trace) {
+          ARMEmitter::ForwardLabel Skip;
+          // Slot index lives in guest X1 at routine entry.
+          const auto SlotIndex = StaticRegisters[X86State::REG_RCX];
+          LoadConstant(ARMEmitter::Size::i64Bit, TMP3, 0x0000800000000000ULL);
+          add(ARMEmitter::Size::i64Bit, TMP3, TMP3, SlotIndex, ARMEmitter::ShiftType::LSL, 0);
+          str(TMP3, TMP4, TMP2, ARMEmitter::ExtendedType::LSL_64, 3);
+          add(ARMEmitter::Size::i64Bit, TMP2, TMP2, 1);
+          and_(ARMEmitter::Size::i64Bit, TMP2, TMP2, FEXCore::Core::IosBlockRingEntries - 1);
+          // Read the slot table entry the routine will use, if addressable.
+          lsr(ARMEmitter::Size::i64Bit, TMP3, SlotIndex, 46);
+          (void)cbnz(ARMEmitter::Size::i64Bit, TMP3, &Skip);
+          ldr(TMP3, SlotIndex, 0);
+          str(TMP3, TMP4, TMP2, ARMEmitter::ExtendedType::LSL_64, 3);
+          add(ARMEmitter::Size::i64Bit, TMP2, TMP2, 1);
+          and_(ARMEmitter::Size::i64Bit, TMP2, TMP2, FEXCore::Core::IosBlockRingEntries - 1);
+          (void)Bind(&Skip);
+        }
+      }
+#endif
       str(TMP2, TMP1, 0);
       (void)Bind(&l_NoRing);
     }
